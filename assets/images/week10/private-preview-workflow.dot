// Source for the PDF fallback image of the Private Preview workflow (HTML uses the live mermaid).
// Regenerate: dot -Tpng -Gdpi=150 private-preview-workflow.dot -o private-preview-workflow.png
digraph workflow {
  rankdir=LR;
  graph [bgcolor="white", fontname="Helvetica", nodesep=0.4, ranksep=0.55];
  node  [shape=box, style="rounded,filled", fillcolor="#eef3f5", color="#2f6f73",
         fontname="Helvetica", fontsize=11, margin="0.14,0.09"];
  edge  [fontname="Helvetica", fontsize=10, color="#444444"];

  A [label="Edit report.qmd\nin your Codespace"];
  B [label="Render with Quarto\n(creates report.html)"];
  C [label="Preview the HTML\nin your browser"];
  D [label="Commit and sync\nto GitHub"];
  E [shape=diamond, fillcolor="#fdebcf", color="#b8860b", label="Privacy checks\npassed?"];
  F [label="Private preview:\nstaff view the HTML in the\nrepo or a fresh Codespace"];
  G [label="GitHub Pages:\npublic website"];

  A -> B; B -> C;
  C -> D [label="Looks right"];
  C -> A [label="Something is off"];
  D -> E;
  E -> F [label="Default route"];
  E -> G [label="Optional, only if safe"];
}
